{
  "name": "papersnap",
  "version": "1.0.1",
  "private": true,
  "description": "PaperSnap — offline document scanner. PWA for iPhone, Capacitor APK for Android. No backend.",
  "type": "module",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs && node scripts/gen-icons.mjs",
    "dev": "npm run assets && vite --host",
    "build": "npm run assets && vite build && node scripts/gen-sw.mjs",
    "build:android": "npm run build && node scripts/strip-ocr-lang.mjs && npx cap sync android",
    "preview": "vite preview --host",
    "test": "node tests/run-pipeline.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "preact": "^11.2.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3",
    "@preact/preset-vite": "^2.10.6",
    "@techstark/opencv-js": "^5.0.0-release.1",
    "@tesseract.js-data/chi_sim": "^1.0.0",
    "@tesseract.js-data/chi_tra": "^1.0.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/msa": "^1.0.0",
    "sharp": "^0.35.5",
    "tesseract.js-core": "^7.0.0",
    "vite": "^8.3.8"
  },
  "license": "MIT"
}
